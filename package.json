{
  "name": "catalog-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Product catalog, owner dashboard, and optional Stripe Checkout extension",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "check": "node --check server/index.js && node --check server/payments/stripe.js"
  },
  "dependencies": {
    "dotenv": "^16.6.0",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "^6.3.5"
  },
  "engines": { "node": ">=20" }
}
# Copy to .env and change both secrets before putting the site online.
PORT=3001
ADMIN_PASSWORD=replace-with-a-strong-unique-password
SESSION_SECRET=replace-with-a-long-random-session-secret
PUBLIC_BASE_URL=http://localhost:5173
# Shared private customer code (8+ chars). NEVER put this in public JavaScript or GitHub.
CUSTOMER_ACCESS_CODE=replace-with-a-long-private-code

# OPTIONAL: Stripe extension (disabled by default)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COLLECT_SHIPPING=false
STRIPE_SHIPPING_COUNTRIES=US,CA
STRIPE_AUTOMATIC_TAX=false

# Optional custom persistent directory; needed on some hosting providers.
# DATA_DIR=./server/data
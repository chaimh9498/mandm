# MNMWhole production configuration — https://mnmwhole.com
# Create a Clerk application at https://dashboard.clerk.com
# Set these privately in your hosting provider. Never commit actual keys.
PORT=3001
NODE_ENV=production
PUBLIC_BASE_URL=https://mnmwhole.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# The Clerk user ID of the owner (user_...). Only this account can edit inventory/orders.
CLERK_OWNER_USER_ID=
# Random long secret; store privately.
SESSION_SECRET=

# Optional Stripe payments — disabled until tested and deliberately enabled
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COLLECT_SHIPPING=false
STRIPE_SHIPPING_COUNTRIES=US,CA
STRIPE_AUTOMATIC_TAX=false

# Must point to a persistent mounted disk; ephemeral storage loses inventory/uploads
DATA_DIR=./server/data
